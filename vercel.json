{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\"; type=\"application/openapi+json\", </.well-known/ard.json>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/",
      "headers": [{ "key": "Vary", "value": "Accept, User-Agent" }]
    },
    {
      "source": "/sites/www/",
      "headers": [{ "key": "Vary", "value": "Accept, User-Agent" }]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept" }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json;profile=\"https://www.rfc-editor.org/info/rfc9727\""
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/mcp/(.*)/server-card",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }]
    },
    {
      "source": "/knowledge/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/contact", "destination": "/sites/contact", "permanent": false },
    { "source": "/contact/", "destination": "/sites/contact", "permanent": false },
    { "source": "/deprecation", "destination": "/developers/deprecation", "permanent": false },
    { "source": "/docs/deprecation", "destination": "/developers/deprecation", "permanent": false },
    { "source": "/versioning", "destination": "/developers/deprecation", "permanent": false },
    { "source": "/developer", "destination": "/developers", "permanent": true },
    { "source": "/api-docs", "destination": "/developers", "permanent": false },
    { "source": "/docs/api", "destination": "/developers", "permanent": false },
    { "source": "/sdk", "destination": "/developers#sdk", "permanent": false },
    { "source": "/cli", "destination": "/developers#sdk", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "mode", "value": "agent" }],
      "destination": "/agent/mode.json"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": "text/markdown" }],
      "destination": "/sites/www/index.md"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "GPTBot|ClaudeBot|ChatGPT-User|PerplexityBot|Google-Extended|Applebot-Extended|ora-agent|DeepSeekBot"
        }
      ],
      "destination": "/sites/www/index.md"
    },
    { "source": "/index.md", "destination": "/sites/www/index.md" },
    { "source": "/favicon.svg", "destination": "/assets/icons/favicon.svg" },
    { "source": "/auth.md", "destination": "/discovery/auth.md" },
    { "source": "/pricing.md", "destination": "/discovery/pricing.md" },
    { "source": "/skills.md", "destination": "/discovery/skills.md" },
    { "source": "/agent.md", "destination": "/discovery/agent.md" },
    { "source": "/api.md", "destination": "/discovery/api.md" },
    { "source": "/developer.md", "destination": "/discovery/developer.md" },
    { "source": "/developers.md", "destination": "/discovery/developers.md" },
    { "source": "/llms.md", "destination": "/discovery/llms.md" },
    { "source": "/llms-full.txt", "destination": "/discovery/llms-full.txt" },
    { "source": "/openapi.json", "destination": "/discovery/openapi.json" },
    { "source": "/schemamap.xml", "destination": "/discovery/schemamap.xml" },
    { "source": "/api/v1/jobs.md", "destination": "/discovery/jobs.md" },
    { "source": "/api/v1/sandbox.md", "destination": "/discovery/sandbox.md" },
    { "source": "/.well-known/llms.txt", "destination": "/llms.txt" },
    { "source": "/.well-known/api-catalog", "destination": "/api/linkset" },
    { "source": "/.well-known/api-catalog/", "destination": "/api/linkset" },
    { "source": "/api/llms.txt.md", "destination": "/section-llms/api.md" },
    { "source": "/developers/llms.txt.md", "destination": "/developers/llms.md" },
    { "source": "/developers/deprecation.md", "destination": "/developers/deprecation/index.md" },
    { "source": "/developers/deprecation/.md", "destination": "/developers/deprecation/index.md" },
    { "source": "/agents.md", "destination": "/AGENTS.md" },
    { "source": "/api/llms.txt", "destination": "/section-llms/api.txt" },
    { "source": "/ask", "destination": "/api/ask" },
    { "source": "/ask/", "destination": "/api/ask" },
    { "source": "/api/v1/sandbox", "destination": "/api/sandbox" },
    { "source": "/api/v1/sandbox/", "destination": "/api/sandbox" },
    { "source": "/v1/sandbox", "destination": "/api/sandbox" },
    { "source": "/v1/sandbox/", "destination": "/api/sandbox" },
    { "source": "/api/v1/batch", "destination": "/api/batch" },
    { "source": "/api/v1/batch/", "destination": "/api/batch" },
    { "source": "/v1/batch", "destination": "/api/batch" },
    { "source": "/v1/batch/", "destination": "/api/batch" },
    { "source": "/api/v1/jobs", "destination": "/api/jobs" },
    { "source": "/api/v1/jobs/", "destination": "/api/jobs" },
    { "source": "/api/v1/jobs/:id", "destination": "/api/jobs?id=:id" },
    { "source": "/api/v1/jobs/:id/", "destination": "/api/jobs?id=:id" },
    { "source": "/v1/jobs", "destination": "/api/jobs" },
    { "source": "/v1/jobs/", "destination": "/api/jobs" },
    { "source": "/v1/jobs/:id", "destination": "/api/jobs?id=:id" },
    { "source": "/v1/jobs/:id/", "destination": "/api/jobs?id=:id" },
    { "source": "/api", "destination": "/api/guard" },
    { "source": "/api/", "destination": "/api/guard" },
    { "source": "/api/v1", "destination": "/api/guard" },
    { "source": "/api/v1/", "destination": "/api/guard" },
    { "source": "/v1", "destination": "/api/guard" },
    { "source": "/v1/", "destination": "/api/guard" },
    { "source": "/v2", "destination": "/api/guard" },
    { "source": "/v2/", "destination": "/api/guard" },
    { "source": "/agent/identity", "destination": "/api/agent?op=identity" },
    { "source": "/agent/identity/", "destination": "/api/agent?op=identity" },
    { "source": "/agent/auth", "destination": "/api/agent?op=identity" },
    { "source": "/agent/auth/", "destination": "/api/agent?op=identity" },
    { "source": "/agent/claim", "destination": "/api/agent?op=claim" },
    { "source": "/agent/claim/", "destination": "/api/agent?op=claim" },
    { "source": "/agent/identity/claim", "destination": "/api/agent?op=claim" },
    { "source": "/agent/identity/claim/", "destination": "/api/agent?op=claim" },
    { "source": "/agent/events", "destination": "/api/agent?op=events" },
    { "source": "/agent/events/", "destination": "/api/agent?op=events" },
    { "source": "/oauth/register", "destination": "/api/agent?op=register" },
    { "source": "/oauth/register/", "destination": "/api/agent?op=register" },
    { "source": "/oauth/token", "destination": "/api/agent?op=token" },
    { "source": "/oauth/token/", "destination": "/api/agent?op=token" },
    { "source": "/oauth/revoke", "destination": "/api/agent?op=revoke" },
    { "source": "/oauth/revoke/", "destination": "/api/agent?op=revoke" },
    { "source": "/oauth/authorize", "destination": "/api/agent?op=authorize" },
    { "source": "/oauth/authorize/", "destination": "/api/agent?op=authorize" },
    { "source": "/mcp", "destination": "/mcp.json" },
    { "source": "/mcp/", "destination": "/mcp.json" },
    { "source": "/mcp/product", "destination": "/api/mcp?surface=product" },
    { "source": "/mcp/product/", "destination": "/api/mcp?surface=product" },
    { "source": "/mcp/knowledge", "destination": "/api/mcp?surface=product" },
    { "source": "/mcp/knowledge/", "destination": "/api/mcp?surface=product" },
    { "source": "/mcp/docs", "destination": "/api/mcp?surface=docs" },
    { "source": "/mcp/docs/", "destination": "/api/mcp?surface=docs" },
    { "source": "/a2a", "destination": "/api/a2a" },
    { "source": "/a2a/", "destination": "/api/a2a" },
    { "source": "/:path(.*)", "destination": "/api/not-found?path=:path" }
  ]
}
